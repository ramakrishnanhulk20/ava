# Upstash Redis REST URL for the shared counters and locks (Upstash console, your database, REST API). https only.
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST token for the same database. Server only: never under a NEXT_PUBLIC_ name.
UPSTASH_REDIS_REST_TOKEN=
# Vercel Blob read-write token (Vercel dashboard, Storage, your blob store, the .env.local tab). Server only.
BLOB_READ_WRITE_TOKEN=
# Public origin of the blob store, https only, no path and no trailing slash, like https://abc123.public.blob.vercel-storage.com
BLOB_ORIGIN=
# Chain REST the proxy forwards to. Leave empty to use the QoreChain testnet, https://api-testnet.qore.host
REST_UPSTREAM=


# The relayer's 24-word recovery phrase: its own account, used only to pay for relayed board actions. `npx tsx scripts/new-relayer.ts` writes it here; never type or paste it. Server only, never under a NEXT_PUBLIC_ name. Testnet only.
RELAYER_MNEMONIC=
# The sponsor's 24-word recovery phrase: its own account, used only to send each new identity the QOR for its two key registrations. `npx tsx scripts/new-sponsor.ts` writes it here; never type or paste it. Server only, never under a NEXT_PUBLIC_ name. Testnet only.
SPONSOR_MNEMONIC=
# The demo board chair's 24-word recovery phrase (the Q-Day Drill account). Its ML-DSA-87 key is the account's whole protection once the drill key is public, so only the demo bot reads it. Server only, never under a NEXT_PUBLIC_ name. Testnet only.
DEMO_CHAIR_MNEMONIC=
# New ML-DSA-87 phrase for the demo chair after a key rotation (scripts/rotate-demo-chair.ts writes it). Server secret.
DEMO_CHAIR_PQC_MNEMONIC=
# The demo board's id. scripts/seed-demo-board.ts writes it once the board is seeded (from 19 Nov); until then the demo endpoints answer 503 not_ready.
DEMO_BOARD_ID=
# The seeded demo directors (Asha, Ben, Chen) as comma-separated addresses, never removed by the guest sweep. Written by scripts/seed-demo-board.ts.
DEMO_SEEDED=
# The seeded directors' 24-word recovery phrases, test identities on the demo board only. scripts/seed-demo-board.ts writes them here; never type or paste them. Testnet only.
DEMO_ASHA_MNEMONIC=
DEMO_BEN_MNEMONIC=
DEMO_CHEN_MNEMONIC=
