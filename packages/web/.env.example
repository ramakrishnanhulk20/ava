# The board whose live numbers the hero shows. Board 15 is the demo board on the testnet registry.
NEXT_PUBLIC_DEMO_BOARD_ID=15
# Block where the demo board's BoardCreated event landed. Found once with a read-only script: eth_getLogs on
# the registry for BoardCreated with the board id as topic, paged in 10,000-block steps from the deploy block 10235963.
NEXT_PUBLIC_DEMO_FROM_BLOCK=10353967
# The demo board's own personas, as Name=address pairs. The chair is the board's creator. Asha and Ben are the
# seeded directors the demo bot added. Chen is the seeded director removed during seeding (the earliest MemberRemoved
# on the board for 0x799b62B0). The names live here so no component types them.
NEXT_PUBLIC_DEMO_DIRECTORS=Chair=0x4786dCd1301432DDFaF65e0d089CbDEFA6ccEa24,Asha=0xae2f223C8a95b7933a4516bDE5853C1D90AE85b0,Ben=0xc6c567A4Dcde90090e7F57bc7829ebcb3A3e9801,Chen=0x799b62B018f704a400AdceFbF384b0926762e5a2
# The drill account is the demo chair. Both forms of the address are public.
NEXT_PUBLIC_DRILL_ACCOUNT_QOR1=qor1g7rde5fszsedm7hktcxs389aa7nve63y4hpfwy
NEXT_PUBLIC_DRILL_ACCOUNT_EVM=0x4786dCd1301432DDFaF65e0d089CbDEFA6ccEa24
# The blob store's public origin, the same value as BLOB_ORIGIN below, so the browser reads envelopes and packs itself.
NEXT_PUBLIC_BLOB_ORIGIN=

# Server only from here on: read by the API route handlers, never under a NEXT_PUBLIC_ name. Same values as packages/server/.env.
# Upstash Redis REST URL for the shared counters and locks (Upstash console, your database, REST API). https only.
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST token for the same database. Server only.
UPSTASH_REDIS_REST_TOKEN=
# Vercel Blob read-write token (Vercel dashboard, Storage, your blob store, the .env.local tab). Server only.
BLOB_READ_WRITE_TOKEN=
# Public origin of the blob store, https only, no path and no trailing slash, like https://abc123.public.blob.vercel-storage.com
BLOB_ORIGIN=
# Chain REST the proxy forwards to. Leave empty to use the QoreChain testnet, https://api-testnet.qore.host
REST_UPSTREAM=
# The relayer's 24-word recovery phrase, which pays for relayed board actions. packages/server scripts/new-relayer.ts writes it. Testnet only.
RELAYER_MNEMONIC=
# The sponsor's 24-word recovery phrase, which funds each new identity's two key registrations. packages/server scripts/new-sponsor.ts writes it. Testnet only.
SPONSOR_MNEMONIC=
# The demo board chair's 24-word recovery phrase (the Q-Day Drill account), read only by the demo bot. Testnet only.
DEMO_CHAIR_MNEMONIC=
# The demo board's id, written by packages/server scripts/seed-demo-board.ts. Until it is set the demo endpoints answer 503 not_ready.
DEMO_BOARD_ID=
# The seeded demo directors as comma-separated addresses, never removed by the guest sweep. Required whenever DEMO_BOARD_ID is set.
DEMO_SEEDED=
# Shared secret Vercel cron sends as "Authorization: Bearer <secret>" to /api/cron/*. 32 random bytes as hex, like the output of: openssl rand -hex 32
CRON_SECRET=
