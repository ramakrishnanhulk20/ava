# 24-word phrase of a fresh testnet-only wallet used only for attack scripts; never a real wallet
SECURITY_TESTNET_KEY=
# Public origin of our blob store, the same value as BLOB_ORIGIN in packages/server/.env, like https://abc123.public.blob.vercel-storage.com
BLOB_ORIGIN=
# The demo board's id, the same value as DEMO_BOARD_ID in packages/server/.env; the demo attacks report "not run" while it is empty
DEMO_BOARD_ID=
# The seeded demo directors, the same comma-separated addresses as DEMO_SEEDED in packages/server/.env
DEMO_SEEDED=
# The demo chair's secp256k1 key exactly as the Q-Day Drill's public attack log prints it; leave empty until that log is out
DRILL_PUBLISHED_KEY=
