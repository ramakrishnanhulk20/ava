{
  "name": "@ava/security",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Ava's attack suite: one live attack per threat-model invariant, against our own testnet contracts and our own local server only.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "new-wallet": "tsx new-wallet.ts",
    "register-wallet": "tsx register-wallet.ts",
    "dry-run": "tsx run.ts --dry-run",
    "attack": "tsx run.ts"
  },
  "dependencies": {
    "@ava/core": "file:../packages/core",
    "@ava/server": "file:../packages/server",
    "@qorechain/evm": "0.14.0",
    "@qorechain/qoreseal": "0.1.0",
    "@qorechain/sdk": "0.14.0",
    "@vercel/blob": "2.9.0",
    "viem": "2.57.20"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
